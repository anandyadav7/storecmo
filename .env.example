# Public site URL used for canonical links, sitemap, feed, and structured data.
NEXT_PUBLIC_SITE_URL=https://storecmo.com

# Optional. Shown on the contact page as a mailto link when set.
NEXT_PUBLIC_CONTACT_EMAIL=

# Form delivery. Each submission is POSTed as JSON to these URLs
# (Formspree, Zapier, Make, Slack incoming webhook, or your own endpoint).
# When unset, submissions are logged to the server console instead.
WAITLIST_WEBHOOK_URL=
CONTACT_WEBHOOK_URL=
